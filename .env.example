# Database Configuration
# Format: postgresql+psycopg2://<user>:<password>@<host>:<port>/<dbname>
# For local PostgreSQL with pgvector:
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/mm_chatbot
# For Cloud PostgreSQL (e.g. Neon, Supabase):
# DATABASE_URL=postgresql+psycopg2://user:password@ep-sample-12345.us-east-2.aws.neon.tech/mm_chatbot?sslmode=require

# AI Provider Configuration
# Choose "gemini" (recommended, free tier) or "openai"
DEFAULT_AI_PROVIDER=gemini

# Google Gemini API Key (Get a free key at: https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004

# OpenAI API Key (Optional alternative)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Embedding Configuration
EMBEDDING_PROVIDER=gemini
# Vector Dimension: 768 for gemini (text-embedding-004), 1536 for openai (text-embedding-3-small)
EMBEDDING_DIMENSION=768

# Web Search Provider (duckduckgo requires no key; tavily is optional)
WEB_SEARCH_PROVIDER=duckduckgo
TAVILY_API_KEY=

# Local Storage
STORAGE_DIR=./storage
MAX_UPLOAD_SIZE_MB=10

# Server & Network Configuration
API_HOST=127.0.0.1
API_PORT=8000
BACKEND_API_URL=http://127.0.0.1:8000
CORS_ORIGINS=http://localhost:8501,http://127.0.0.1:8501
